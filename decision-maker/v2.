<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fun Decision Maker</title>
    <!-- Tailwind CSS CDN for swift, responsive utility layout -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti Library for celebratory visual effects -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Font Awesome Icons for visual cues -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* v2.0 - Decision Maker Custom Styles */
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap');

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #6EE7B7 0%, #3B82F6 50%, #9333EA 100%);
            min-height: 100vh;
        }

        h1, h2, h3, .fun-font {
            font-family: 'Fredoka', sans-serif;
        }

        /* Bouncy subtle animation for interactive buttons */
        .bounce-on-hover {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
        }
        .bounce-on-hover:hover {
            transform: translateY(-3px) scale(1.02);
        }
        .bounce-on-hover:active {
            transform: translateY(1px) scale(0.98);
        }

        /* Pulsing glow effect for the main decision button */
        .pulse-glow {
            animation: pulseGlow 2s infinite;
        }
        @keyframes pulseGlow {
            0%, 100% {
                box-shadow: 0 0 15px rgba(236, 72, 153, 0.6), 0 0 30px rgba(236, 72, 153, 0.3);
            }
            50% {
                box-shadow: 0 0 25px rgba(236, 72, 153, 0.9), 0 0 45px rgba(236, 72, 153, 0.5);
            }
        }

        /* Rapid shuffle card highlight effect */
        .picking-highlight {
            transform: scale(1.08) translateY(-4px);
            background-color: #FDE047 !important;
            border-color: #EAB308 !important;
            color: #1E293B !important;
            box-shadow: 0 10px 25px -5px rgba(234, 179, 8, 0.5);
        }

        /* Subtle shake animation for error/polite notifications */
        @keyframes subtleShake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }
        .shake {
            animation: subtleShake 0.4s ease-in-out;
        }
    </style>
</head>
<body class="flex flex-col items-center justify-between p-4 sm:p-6 md:p-8 text-slate-800 antialiased selection:bg-pink-300">

    <!-- Main Application Container -->
    <main class="w-full max-w-2xl bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border-4 border-white p-6 sm:p-8 my-auto transition-all">
        
        <!-- Header Banner -->
        <header class="text-center mb-8">
            <div class="inline-block bg-pink-100 text-pink-600 px-4 py-1.5 rounded-full font-bold text-sm mb-3 shadow-inner">
                ✨ Can't Decide? Let Us Choose!
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-pink-500 to-amber-500 tracking-wide mb-2">
                Random Decision Maker
            </h1>
            <p class="text-slate-600 text-base sm:text-lg font-medium">
                Add your choices below, press decide, and let fate take over! 🎲
            </p>
        </header>

        <!-- Input Section: Box and Add Button -->
        <section aria-labelledby="add-option-heading" class="mb-6">
            <h2 id="add-option-heading" class="sr-only">Add New Option</h2>
            <form id="option-form" onsubmit="handleAddOption(event)" class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                    <label for="option-input" class="sr-only">Type your option</label>
                    <input 
                        type="text" 
                        id="option-input" 
                        placeholder="e.g., Pizza 🍕, Tacos 🌮, Sushi 🍣" 
                        class="w-full px-5 py-4 text-lg rounded-2xl border-2 border-purple-200 focus:border-purple-500 focus:ring-4 focus:ring-purple-200 outline-none transition-all shadow-inner placeholder:text-slate-400 font-semibold text-slate-700"
                        maxlength="60"
                        autocomplete="off"
                    />
                </div>
                <button 
                    type="submit" 
                    id="add-btn" 
                    aria-label="Add Option to List"
                    class="bounce-on-hover bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-extrabold text-lg px-8 py-4 rounded-2xl shadow-lg shadow-purple-500/30 flex items-center justify-center gap-2 cursor-pointer transition-all"
                >
                    <i class="fa-solid fa-plus text-xl"></i>
                    <span>Add</span>
                </button>
            </form>
        </section>

        <!-- Dynamic Polite Message / Alert Banner -->
        <div 
            id="status-message" 
            role="status" 
            aria-live="polite" 
            class="hidden mb-6 p-4 rounded-2xl text-center font-bold text-base transition-all duration-300"
        ></div>

        <!-- Options List Section -->
        <section aria-labelledby="options-list-heading" class="mb-8">
            <div class="flex items-center justify-between mb-3 px-1">
                <h2 id="options-list-heading" class="text-xl font-bold text-slate-700 flex items-center gap-2">
                    <span>Your Options</span>
                    <span id="option-count" class="bg-purple-100 text-purple-700 text-xs px-2.5 py-1 rounded-full font-extrabold">0</span>
                </h2>
                <div class="flex items-center gap-2">
                    <button 
                        id="share-link-btn" 
                        onclick="handleCopyLink()" 
                        class="text-xs font-bold bg-purple-50 text-purple-600 hover:bg-purple-100 border border-purple-200 px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 hidden"
                        aria-label="Copy link to this page with current options"
                    >
                        <i class="fa-solid fa-link text-purple-500"></i>
                        <span>Copy Link</span>
                    </button>
                    <button 
                        id="clear-all-btn" 
                        onclick="handleClearAll()" 
                        class="text-xs font-bold text-slate-400 hover:text-red-500 px-2 py-1 rounded-lg transition-colors hidden"
                        aria-label="Clear all options"
                    >
                        Clear All
                    </button>
                </div>
            </div>

            <!-- Empty List Visual Placeholder -->
            <div id="empty-state" class="text-center py-10 px-4 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50/50">
                <p class="text-4xl mb-2">🎈</p>
                <p class="text-slate-500 font-bold">No options added yet!</p>
                <p class="text-slate-400 text-sm mt-1">Type something above and click 'Add' to get started.</p>
            </div>

            <!-- Dynamic Container for Added Option Pills -->
            <div 
                id="options-container" 
                class="flex flex-wrap gap-3 max-h-60 overflow-y-auto p-1 custom-scrollbar"
                role="list"
                aria-label="Current list of options"
            ></div>
        </section>

        <!-- Big Prominent Decide Button -->
        <section class="text-center mb-2">
            <button 
                id="decide-btn" 
                onclick="handleDecide()" 
                aria-label="Decide and pick a random option"
                class="pulse-glow bounce-on-hover w-full py-5 px-8 bg-gradient-to-r from-pink-500 via-rose-500 to-amber-500 hover:from-pink-600 hover:to-amber-600 text-white fun-font font-black text-2xl sm:text-3xl tracking-wide rounded-2xl shadow-xl shadow-pink-500/40 cursor-pointer transition-all flex items-center justify-center gap-3 border-2 border-white/40"
            >
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span>DECIDE!</span>
            </button>
        </section>

    </main>

    <!-- Winner Decision Modal Overlay -->
    <div 
        id="result-modal" 
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 opacity-0 pointer-events-none transition-opacity duration-300"
        aria-hidden="true"
        role="dialog"
        aria-labelledby="modal-title"
    >
        <div 
            id="result-modal-card" 
            class="bg-white w-full max-w-md rounded-3xl p-8 text-center shadow-2xl border-4 border-yellow-300 transform scale-90 transition-transform duration-300"
        >
            <div class="text-5xl mb-3 animate-bounce">🎉</div>
            <p id="modal-title" class="text-sm font-extrabold uppercase tracking-widest text-purple-600 mb-1">The Winner Is!</p>
            
            <div class="my-6 p-6 bg-gradient-to-r from-yellow-100 via-amber-100 to-yellow-100 rounded-2xl border-2 border-yellow-300 shadow-inner">
                <h3 
                    id="modal-result-text" 
                    class="text-3xl sm:text-4xl font-extrabold text-slate-800 break-words fun-font"
                    aria-live="assertive"
                >
                    Result Here
                </h3>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <button 
                    onclick="handleDecide()" 
                    class="bounce-on-hover flex-1 py-3 px-5 bg-purple-600 hover:bg-purple-700 text-white font-extrabold rounded-xl shadow-md transition-colors"
                >
                    <i class="fa-solid fa-rotate-right mr-1"></i> Pick Again
                </button>
                <button 
                    onclick="closeResultModal()" 
                    class="bounce-on-hover flex-1 py-3 px-5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-extrabold rounded-xl transition-colors"
                >
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-6 text-center text-white/80 font-semibold text-sm">
        <p>Built for fun choices • Runs 100% in your browser 🚀</p>
    </footer>

    <script>
        // // v2.0 - Decision Maker Application Script
        // Completely Vanilla JS with thorough plain-language comments

        // State Array: Holds all added choices
        let options = [];
        // Flag: Prevents multiple shuffle animations from running simultaneously
        let isDeciding = false;

        // Element References: Cached for performance and easy DOM access
        const optionForm = document.getElementById('option-form');
        const optionInput = document.getElementById('option-input');
        const optionsContainer = document.getElementById('options-container');
        const emptyState = document.getElementById('empty-state');
        const statusMessage = document.getElementById('status-message');
        const optionCountBadge = document.getElementById('option-count');
        const clearAllBtn = document.getElementById('clear-all-btn');
        const shareLinkBtn = document.getElementById('share-link-btn');
        const decideBtn = document.getElementById('decide-btn');
        const resultModal = document.getElementById('result-modal');
        const resultModalCard = document.getElementById('result-modal-card');
        const modalResultText = document.getElementById('modal-result-text');

        /**
         * Reads URL query parameters when the app opens.
         * If `?options=Pizza,Tacos` exists, it loads those choices into the list.
         */
        function initializeFromURL() {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const rawOptions = urlParams.get('options');

                if (rawOptions) {
                    const parsedOptions = rawOptions
                        .split(',')
                        .map(opt => decodeURIComponent(opt.trim()))
                        .filter(opt => opt.length > 0);

                    if (parsedOptions.length > 0) {
                        options = parsedOptions;
                        showStatusMessage("Loaded your shared options list! Ready to decide?", "info");
                    }
                }
            } catch (err) {
                console.error("Failed to parse URL options parameter:", err);
            }
        }

        /**
         * Copies a shareable link with current options embedded in the URL parameters.
         */
        function handleCopyLink() {
            if (options.length === 0) {
                showStatusMessage("Add at least one option before copying a link!", "alert");
                return;
            }

            const encodedOptions = options.map(opt => encodeURIComponent(opt)).join(',');
            const shareableURL = `${window.location.origin}${window.location.pathname}?options=${encodedOptions}`;

            const notifyCopied = () => {
                showStatusMessage("Link copied to clipboard! Share it with your friends!", "info");
                const originalText = shareLinkBtn.innerHTML;
                shareLinkBtn.innerHTML = '<i class="fa-solid fa-check text-green-500"></i><span>Copied!</span>';
                setTimeout(() => {
                    shareLinkBtn.innerHTML = originalText;
                }, 2000);
            };

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(shareableURL)
                    .then(notifyCopied)
                    .catch(() => fallbackCopyTextToClipboard(shareableURL, notifyCopied));
            } else {
                fallbackCopyTextToClipboard(shareableURL, notifyCopied);
            }
        }

        /**
         * STREAMING_CHUNK:Implementing clipboard fallback and list editing logic...
         * Fallback copy method for iframe or restricted web contexts.
         */
        function fallbackCopyTextToClipboard(text, onSuccess) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                const successful = document.execCommand('copy');
                if (successful && onSuccess) onSuccess();
            } catch (err) {
                showStatusMessage("Unable to copy link automatically. Please copy the URL manually.", "alert");
            }
            document.body.removeChild(textArea);
        }

        /**
         * Adds a new option to the list when form is submitted.
         */
        function handleAddOption(event) {
            event.preventDefault();

            const value = optionInput.value.trim();

            if (!value) {
                showStatusMessage("Please type something before clicking Add! 😊", "alert");
                optionInput.focus();
                return;
            }

            const isDuplicate = options.some(opt => opt.toLowerCase() === value.toLowerCase());
            if (isDuplicate) {
                showStatusMessage(`"${value}" is already in your options list!`, "alert");
                optionInput.focus();
                return;
            }

            options.push(value);
            optionInput.value = '';
            optionInput.focus();

            hideStatusMessage();
            renderOptionsList();
        }

        /**
         * Removes a specific option by array index.
         */
        function handleRemoveOption(index) {
            if (isDeciding) return;
            options.splice(index, 1);
            hideStatusMessage();
            renderOptionsList();
        }

        /**
         * Clears all items from the options list.
         */
        function handleClearAll() {
            if (isDeciding) return;
            options = [];
            hideStatusMessage();
            renderOptionsList();
            optionInput.focus();
        }

        /**
         * Re-renders the options cards and updates empty state indicators.
         */
        function renderOptionsList() {
            optionCountBadge.textContent = options.length;

            if (options.length === 0) {
                emptyState.classList.remove('hidden');
                optionsContainer.classList.add('hidden');
                clearAllBtn.classList.add('hidden');
                shareLinkBtn.classList.add('hidden');
            } else {
                emptyState.classList.add('hidden');
                optionsContainer.classList.remove('hidden');
                clearAllBtn.classList.remove('hidden');
                shareLinkBtn.classList.remove('hidden');
            }

            optionsContainer.innerHTML = '';

            options.forEach((opt, index) => {
                const pill = document.createElement('div');
                pill.className = "option-pill flex items-center justify-between gap-3 bg-slate-100 hover:bg-slate-200 border-2 border-slate-200 text-slate-800 font-extrabold px-4 py-2.5 rounded-2xl transition-all duration-200 text-base shadow-sm";
                pill.setAttribute('role', 'listitem');

                const textSpan = document.createElement('span');
                textSpan.className = "truncate max-w-[200px] sm:max-w-[300px]";
                textSpan.textContent = opt;

                const removeBtn = document.createElement('button');
                removeBtn.type = "button";
                removeBtn.className = "text-slate-400 hover:text-red-500 p-1 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-red-400";
                removeBtn.setAttribute('aria-label', `Remove option: ${opt}`);
                removeBtn.innerHTML = '<i class="fa-solid fa-xmark text-lg"></i>';
                removeBtn.onclick = () => handleRemoveOption(index);

                pill.appendChild(textSpan);
                pill.appendChild(removeBtn);
                optionsContainer.appendChild(pill);
            });
        }

        /**
         * STREAMING_CHUNK:Implementing random shuffle algorithm, animations, and modals...
         * Handles random decision picking with rapid visual shuffle animation.
         */
        function handleDecide() {
            if (isDeciding) return;

            // Polite check when fewer than 2 options exist
            if (options.length < 2) {
                showStatusMessage(
                    "Please add at least 2 options so I can make a fair choice for you! 😊", 
                    "alert"
                );
                return;
            }

            hideStatusMessage();
            closeResultModal();

            isDeciding = true;
            decideBtn.disabled = true;
            decideBtn.classList.add('opacity-75', 'cursor-not-allowed');

            const pills = optionsContainer.querySelectorAll('.option-pill');
            let shuffleCount = 0;
            const totalShuffles = 18;
            const speed = 90;

            const shuffleInterval = setInterval(() => {
                pills.forEach(p => p.classList.remove('picking-highlight'));

                const randomIndex = Math.floor(Math.random() * options.length);
                if (pills[randomIndex]) {
                    pills[randomIndex].classList.add('picking-highlight');
                }

                shuffleCount++;

                if (shuffleCount >= totalShuffles) {
                    clearInterval(shuffleInterval);

                    const winnerIndex = Math.floor(Math.random() * options.length);
                    const chosenOption = options[winnerIndex];

                    pills.forEach(p => p.classList.remove('picking-highlight'));
                    if (pills[winnerIndex]) {
                        pills[winnerIndex].classList.add('picking-highlight');
                    }

                    setTimeout(() => {
                        if (pills[winnerIndex]) {
                            pills[winnerIndex].classList.remove('picking-highlight');
                        }
                        showWinnerModal(chosenOption);

                        isDeciding = false;
                        decideBtn.disabled = false;
                        decideBtn.classList.remove('opacity-75', 'cursor-not-allowed');
                    }, 400);
                }
            }, speed);
        }

        /**
         * Shows user notifications in polite banner element.
         */
        function showStatusMessage(msg, type = "info") {
            statusMessage.textContent = msg;
            statusMessage.classList.remove('hidden', 'bg-amber-100', 'text-amber-800', 'border-amber-300', 'bg-purple-100', 'text-purple-800', 'border-purple-300', 'shake');

            if (type === "alert") {
                statusMessage.classList.add('bg-amber-100', 'text-amber-800', 'border-2', 'border-amber-300', 'shake');
            } else {
                statusMessage.classList.add('bg-purple-100', 'text-purple-800', 'border-2', 'border-purple-300');
            }

            setTimeout(() => statusMessage.classList.remove('shake'), 400);
        }

        /**
         * Hides the status notification banner.
         */
        function hideStatusMessage() {
            statusMessage.classList.add('hidden');
        }

        /**
         * Displays the winning result modal overlay and triggers confetti.
         */
        function showWinnerModal(winningOption) {
            modalResultText.textContent = winningOption;

            resultModal.classList.remove('opacity-0', 'pointer-events-none');
            resultModal.setAttribute('aria-hidden', 'false');

            resultModalCard.classList.remove('scale-90');
            resultModalCard.classList.add('scale-100');

            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        }

        /**
         * Closes the winner modal overlay.
         */
        function closeResultModal() {
            resultModal.classList.add('opacity-0', 'pointer-events-none');
            resultModal.setAttribute('aria-hidden', 'true');
            resultModalCard.classList.remove('scale-100');
            resultModalCard.classList.add('scale-90');
        }
